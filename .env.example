# Copy to .env and fill in ONE block. Never commit .env (it is git-ignored).
# A provider is just base URL + key + model. openai / nim / llama are presets;
# LLM_BASE_URL, LLM_API_KEY and LLM_MODEL override any of the three values.

# ---- NVIDIA NIM (free key: build.nvidia.com) ---------------------------------
LLM_PROVIDER=nim
NVIDIA_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b      # default; copy exact ids from build.nvidia.com
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5       # default
# LLM_BASE_URL=http://localhost:8000/v1         # self-hosted NIM

# ---- OpenAI ------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Open-source Llama (Ollama default; also llama.cpp, vLLM, LM Studio) -----
# LLM_PROVIDER=llama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# EMBEDDING_MODEL=nomic-embed-text

# ---- Any other OpenAI-compatible gateway -------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-gateway.example/v1
# LLM_API_KEY=
# LLM_MODEL=model-id
# EMBEDDING_PROVIDER=hash                       # if the gateway has no /embeddings endpoint

# ---- Embeddings (default: same provider as the LLM) --------------------------
# EMBEDDING_PROVIDER=nim | openai | llama | hash   (hash = offline lexical embedder)
# EMBEDDING_BASE_URL= / EMBEDDING_API_KEY= / EMBEDDING_MODEL=

# ---- Optional tuning ---------------------------------------------------------
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096        # raise if a reasoning model returns empty content
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=2          # transport retries for 429 / 5xx / timeouts
# BUILDER_MAX_REPAIRS=2      # schema-repair attempts per agent step
# RAG_NUM_QUERIES=50         # size of the MS MARCO subset
# RAG_FORCE_LOCAL=0          # 1 = skip Hugging Face, use data/sample_passages.json
# RAG_RETRIEVER=hybrid       # dense | bm25 | hybrid
# RAG_CHUNKER=sentence       # fixed | sentence
# RAG_CHUNK_WORDS=40
# RAG_CHUNK_OVERLAP=10
# RAG_TOP_K=5
# RAG_GRADER=threshold       # threshold | llm (one extra call per retrieval)
# RAG_GRADE_THRESHOLD=0.5
# RAG_MAX_REWRITES=1
